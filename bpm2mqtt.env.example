# Copied to /etc/default/bpm2mqtt by install.sh. Edit there.

# Required: the monitor's Bluetooth address (bluetoothctl shows it as "SBM70").
SBM70_MAC=AA:BB:CC:DD:EE:FF

# Bluetooth adapter (default hci0)
#BT_ADAPTER=hci0

# MQTT broker (the one Home Assistant's MQTT integration uses)
MQTT_HOST=localhost
#MQTT_PORT=1883
#MQTT_USER=
#MQTT_PASSWORD=
#MQTT_CLIENT_ID=bpm2mqtt

# Topics: <base>/status, <base>/user<N>, <base>/last
#MQTT_BASE_TOPIC=sbm70
#HA_DISCOVERY_PREFIX=homeassistant
# Device name in Home Assistant; entity ids follow it (sensor.sbm70_user_1_systolic)
#HA_DEVICE_NAME=SBM70

# Time zone of the monitor's clock (IANA name). Unset = the system time zone.
#MONITOR_TZ=Europe/Berlin

#LOG_LEVEL=INFO
